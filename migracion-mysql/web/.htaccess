# VIP PAITA MIX · reglas de Apache para public_html

# no mostrar el contenido de las carpetas como lista
Options -Indexes

# la portada es index.html (aunque el hosting deje algún index.php suyo)
DirectoryIndex index.html

# config.php tiene la clave de la base de datos: nunca se pide por URL.
# PHP lo carga desde los otros archivos igual (esto solo frena al navegador).
<Files "config.php">
  Require all denied
</Files>

# la configuración de PHP que crea el hosting (límites de subida, etc.)
# tampoco tiene por qué verse desde el navegador (ni sus copias: php.ini.respaldo...)
<FilesMatch "^(php\.ini.*|\.user\.ini)$">
  Require all denied
</FilesMatch>

# HTTPS obligatorio (el certificado SSL ya está instalado)
# (salvo en las pruebas locales, que corren sin certificado)
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(127\.0\.0\.1|localhost)(:[0-9]+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
